<?xml version="1.0" encoding="utf-8"?>
<!-- Selector for server list rows: normal / focused / pressed states (D-pad navigation) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape>
            <solid android:color="#201565C0" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#1565C0" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape>
            <solid android:color="#301565C0" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#141A1A2E" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#1A1A2E" />
        </shape>
    </item>

</selector>
