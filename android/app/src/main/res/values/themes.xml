<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Fullscreen, no action bar, dark background.
        windowLayoutInDisplayCutoutMode = shortEdges lets the WebView use the
        full panel area on TVs / phones with notches.
    -->
    <style name="Theme.Fotify" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryDark">@color/accent_blue_dark</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
