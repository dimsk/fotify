<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- ═══════════════════════════ WebView ═══════════════════════════════ -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ═══════════════════ Empty-state overlay ══════════════════════════
         Shown when the server is reachable but no photo sources are configured.
         clickable + focusable so the overlay captures D-pad / remote input
         and doesn't fall through to the WebView behind it. -->
    <LinearLayout
        android:id="@+id/emptyStateOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/overlay_background"
        android:orientation="vertical"
        android:padding="40dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_photos_title"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_photos_subtitle"
            android:textColor="#AAAAAA"
            android:textSize="15sp"
            android:layout_marginBottom="20dp" />

        <!-- Admin URL highlighted in monospace blue -->
        <TextView
            android:id="@+id/adminUrlText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#64B5F6"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:background="@drawable/url_chip_background"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back_hint_admin"
            android:textColor="#666666"
            android:textSize="13sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/changeServerButton2"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/change_server"
            android:textColor="#AAAAAA"
            android:focusable="true" />

    </LinearLayout>

    <!-- ═══════════════════ Connection-error overlay ══════════════════════
         Shown when the WebView cannot reach the server at all.
         clickable + focusable so the overlay captures D-pad / remote input. -->
    <LinearLayout
        android:id="@+id/connectionErrorOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/overlay_background"
        android:orientation="vertical"
        android:padding="40dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connection_error_title"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Server URL that was attempted -->
        <TextView
            android:id="@+id/connectionErrorUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#AAAAAA"
            android:textSize="15sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="6dp" />

        <!-- Technical error detail (e.g. "net::ERR_CONNECTION_REFUSED (code -6)") -->
        <TextView
            android:id="@+id/connectionErrorDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#555555"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back_hint_retry"
            android:textColor="#555555"
            android:textSize="13sp"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/retryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/retry"
                android:textColor="@android:color/white"
                android:backgroundTint="#1565C0"
                android:focusable="true"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/changeServerButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/change_server"
                android:textColor="#AAAAAA"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
