<?xml version="1.0" encoding="utf-8"?>
<!-- Single row in the discovered-server list -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/server_item_bg"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- mDNS service name, e.g. "Fotify@raspberrypi" -->
        <TextView
            android:id="@+id/serverName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Full URL in monospace blue, e.g. "http://192.168.1.100:15766" -->
        <TextView
            android:id="@+id/serverAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#64B5F6"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- Discovery method badge: mDNS / UDP / HTTP scan / Manual -->
    <TextView
        android:id="@+id/serverMethod"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/server_method_badge_bg"
        android:textColor="#DDEBFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:fontFamily="sans"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_marginStart="16dp" />

</LinearLayout>
